# Copy to .env (gitignored) and pass it: uv run --env-file .env python -m kalo.usda.load
# Matches docker-compose.yml. Create the schema first: uv run --env-file .env alembic upgrade head
DATABASE_URL=postgresql://kalo:kalo@localhost:5432/kalo

# Read by docker-compose too (default kalo). Postgres applies it only when it creates the volume.
# If you set it, use the same password in DATABASE_URL above.
# POSTGRES_PASSWORD=

# The ChatGPT (MCP) deployment: see README "Run it on the Mac".
# uv run --env-file .env uvicorn app.main:app --host 0.0.0.0 --port 8000 ...
# The public https origin, no trailing slash.
# PUBLIC_URL=
# openssl rand -hex 32. Keep it here, never on a command line (shell history).
# KALO_SECRET=
# false once your phone has registered (default true). Reopen to register a new phone.
# ALLOW_REGISTRATION=
