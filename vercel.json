{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "./",
      "installCommand": "npm ci",
      "buildCommand": "EXPO_PUBLIC_API_URL=\"${PUBLIC_URL:?Set PUBLIC_URL in the Vercel project settings}\" npx expo export --platform web && node scripts/sw-manifest.mjs dist",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/_expo/static/(.*)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/sw.js",
          "headers": [
            {
              "key": "Content-Type",
              "value": "text/javascript; charset=utf-8"
            },
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/sw-files.json",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/manifest.json",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/manifest+json"
            }
          ]
        },
        {
          "source": "/assets/(.*).wasm",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/wasm"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ]
    },
    "api": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/mcp",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/mcp/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/oauth/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/.well-known/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
