{
  "_rules": [
    "Shared by backend/tests/test_targets.py and tests/targets.test.mjs. Wire names (protein_g, ...).",
    "day_target: adjustment_kcal = round(steps * 0.035) + (workout_kcal if day_type == 'workout', active_recovery_kcal if 'active_recovery', else 0). steps null counts as 0.",
    "day_target: calories += adjustment_kcal; carbs_g += adjustment_kcal / 4; every other target is the goal's value unchanged. Only adjustment_kcal is rounded.",
    "remaining = target - totals for each of the seven nutrients (may be negative). Compare with a tolerance of 1e-9.",
    "suggest: BMR = 10*weight_kg + 6.25*height_cm - 5*age + (5 if male, -161 if female); calories = round(BMR * 1.2 * {lose: 0.8, maintain: 1.0, gain: 1.1}).",
    "suggest: protein_g = round(1.8 * weight_kg); fat_g = round(0.25 * calories / 9); carbs_g = max(0, round((calories - 4*protein_g - 9*fat_g) / 4)).",
    "round = half away from zero (JS Math.round differs on negative halves; Python round() is banker's): implement explicitly in both."
  ],
  "day_target": [
    {
      "name": "no activity row",
      "goal": { "calories": 2000, "protein_g": 150, "carbs_g": 200, "fat_g": 70, "fiber_g": 30, "sugar_g": 50, "sodium_mg": 2300, "workout_kcal": 300, "active_recovery_kcal": 150 },
      "activity": null,
      "totals": null,
      "expected": { "target": { "calories": 2000, "protein_g": 150, "carbs_g": 200, "fat_g": 70, "fiber_g": 30, "sugar_g": 50, "sodium_mg": 2300, "adjustment_kcal": 0 }, "remaining": null }
    },
    {
      "name": "rest day, no steps",
      "goal": { "calories": 2000, "protein_g": 150, "carbs_g": 200, "fat_g": 70, "fiber_g": 30, "sugar_g": 50, "sodium_mg": 2300, "workout_kcal": 300, "active_recovery_kcal": 150 },
      "activity": { "steps": 0, "day_type": "rest" },
      "totals": null,
      "expected": { "target": { "calories": 2000, "protein_g": 150, "carbs_g": 200, "fat_g": 70, "fiber_g": 30, "sugar_g": 50, "sodium_mg": 2300, "adjustment_kcal": 0 }, "remaining": null }
    },
    {
      "name": "workout day with 10000 steps",
      "goal": { "calories": 2000, "protein_g": 150, "carbs_g": 200, "fat_g": 70, "fiber_g": 30, "sugar_g": 50, "sodium_mg": 2300, "workout_kcal": 300, "active_recovery_kcal": 150 },
      "activity": { "steps": 10000, "day_type": "workout" },
      "totals": null,
      "expected": { "target": { "calories": 2650, "protein_g": 150, "carbs_g": 362.5, "fat_g": 70, "fiber_g": 30, "sugar_g": 50, "sodium_mg": 2300, "adjustment_kcal": 650 }, "remaining": null }
    },
    {
      "name": "active recovery with 4000 steps",
      "goal": { "calories": 2000, "protein_g": 150, "carbs_g": 200, "fat_g": 70, "fiber_g": 30, "sugar_g": 50, "sodium_mg": 2300, "workout_kcal": 300, "active_recovery_kcal": 150 },
      "activity": { "steps": 4000, "day_type": "active_recovery" },
      "totals": null,
      "expected": { "target": { "calories": 2290, "protein_g": 150, "carbs_g": 272.5, "fat_g": 70, "fiber_g": 30, "sugar_g": 50, "sodium_mg": 2300, "adjustment_kcal": 290 }, "remaining": null }
    },
    {
      "name": "steps only, no day type; step calories are rounded",
      "goal": { "calories": 2000, "protein_g": 150, "carbs_g": 200, "fat_g": 70, "fiber_g": 30, "sugar_g": 50, "sodium_mg": 2300, "workout_kcal": 300, "active_recovery_kcal": 150 },
      "activity": { "steps": 1234, "day_type": null },
      "totals": null,
      "expected": { "target": { "calories": 2043, "protein_g": 150, "carbs_g": 210.75, "fat_g": 70, "fiber_g": 30, "sugar_g": 50, "sodium_mg": 2300, "adjustment_kcal": 43 }, "remaining": null }
    },
    {
      "name": "workout day amounts default to 0",
      "goal": { "calories": 1800, "protein_g": 120, "carbs_g": 180, "fat_g": 60, "fiber_g": 25, "sugar_g": 40, "sodium_mg": 2000, "workout_kcal": 0, "active_recovery_kcal": 0 },
      "activity": { "steps": 0, "day_type": "workout" },
      "totals": null,
      "expected": { "target": { "calories": 1800, "protein_g": 120, "carbs_g": 180, "fat_g": 60, "fiber_g": 25, "sugar_g": 40, "sodium_mg": 2000, "adjustment_kcal": 0 }, "remaining": null }
    },
    {
      "name": "remaining, including going over",
