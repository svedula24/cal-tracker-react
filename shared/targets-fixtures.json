    {
      "name": "carbs of exactly 77.5 round up (half away from zero, not banker's)",
      "input": { "sex": "female", "age": 70, "height_cm": 150, "weight_kg": 150, "goal": "lose" },
      "expected": { "calories": 1849, "protein_g": 270, "carbs_g": 78, "fat_g": 51 }
    }
  ]
}
